{
  "name": "dermwatch-local",
  "version": "0.2.6",
  "description": "A private, local photo journal for tracking visible skin changes over time.",
  "author": "Pulse and Amir Mushich",
  "contributors": [
    {
      "name": "Pulse"
    },
    {
      "name": "Amir Mushich",
      "url": "https://x.com/AmirMushich"
    }
  ],
  "main": "desktop/main.mjs",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/amirmushichge/dermwatch#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/amirmushichge/dermwatch.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 3000",
    "local-api": "node server.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && node --check desktop/main.mjs",
    "lint": "eslint .",
    "release:verify-version": "node scripts/verify-release-version.mjs",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:build": "npm run desktop:build:windows",
    "desktop:build:windows": "npm run build && electron-builder --win nsis --publish never",
    "desktop:build:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "desktop:smoke:packaged": "node scripts/smoke-packaged.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk:debug": "npm run android:sync && node scripts/build-android.mjs debug",
    "android:apk:release": "npm run android:sync && node scripts/build-android.mjs release"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@eslint/js": "10.0.1",
    "@fontsource/manrope": "5.2.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  },
  "type": "module",
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/share": "^8.0.1"
  }
}
